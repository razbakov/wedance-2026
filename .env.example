DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Stripe payment processing.
# Get these from https://dashboard.stripe.com/apikeys (use test keys for dev).
# Required by the ticketCheckout tRPC procedure and the Stripe webhook handler.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# TicketTailor webhook signing secret.
# Get this from your TicketTailor account: Settings → Webhooks → create or open a webhook → Signing Secret.
# Required by /api/webhooks/tickettailor to verify HMAC-SHA256 signatures on incoming order events.
TICKETTAILOR_WEBHOOK_SECRET=
