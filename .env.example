DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# TicketTailor webhook signing secret.
# Get this from your TicketTailor account: Settings → Webhooks → create or open a webhook → Signing Secret.
# Required by /api/webhooks/tickettailor to verify HMAC-SHA256 signatures on incoming order events.
TICKETTAILOR_WEBHOOK_SECRET=
