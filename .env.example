DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# TicketTailor webhook signing secret.
# Get this from your TicketTailor account: Settings → Webhooks → create or open a webhook → Signing Secret.
# Required by /api/webhooks/tickettailor to verify HMAC-SHA256 signatures on incoming order events.
TICKETTAILOR_WEBHOOK_SECRET=

# Shared secret for the onboarding quest machine write endpoints (/api/join/*).
# The envoy Telegram bot sends this as the `x-onboarding-secret` header; the
# candidates / advance / cuj routes compare it with timingSafeEqual and fail
# closed (401) when it is unset or mismatched. The public board (GET /api/join/[id])
# needs no secret. Generate a long random value (e.g. `openssl rand -hex 32`).
ONBOARDING_API_SECRET=
